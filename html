<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Website</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #111827, #1e1b4b);
  color: white;
}

nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 7%;
  background: rgba(0,0,0,.35);
  backdrop-filter: blur(10px);
}

.logo {
  font-size: 24px;
  font-weight: bold;
}

.menu {
  display: flex;
  gap: 10px;
}

.menu a {
  color: white;
  text-decoration: none;
  padding: 10px 16px;
  border-radius: 10px;
  transition: .2s;
}

.menu a:hover {
  background: rgba(255,255,255,.15);
}

.hero {
  min-height: calc(100vh - 75px);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 30px;
}

.box {
  max-width: 650px;
}

.box h1 {
  font-size: clamp(40px, 8vw, 70px);
  margin-bottom: 15px;
}

.box p {
  color: #cbd5e1;
  margin-bottom: 30px;
  font-size: 18px;
}

.buttons {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

.btn {
  display: inline-block;
  padding: 15px 25px;
  border-radius: 14px;
  text-decoration: none;
  color: white;
  font-weight: bold;
  background: #4f46e5;
  transition: .2s;
}

.btn:hover {
  transform: translateY(-3px);
  filter: brightness(1.15);
}

.secondary {
  background: #334155;
}

@media(max-width:600px) {
  nav {
    flex-direction: column;
    gap: 12px;
  }

  .menu {
    flex-wrap: wrap;
    justify-content: center;
  }
}
</style>
</head>

<body>

<nav>
  <div class="logo">🚀 MY WEBSITE</div>

  <div class="menu">
    <a href="#home">หน้าแรก</a>
    <a href="#about">เกี่ยวกับ</a>
    <a href="#contact">ติดต่อ</a>
  </div>
</nav>

<section class="hero" id="home">
  <div class="box">

    <h1>ยินดีต้อนรับ</h1>

    <p>
      เว็บไซต์ของฉัน พร้อมเมนูและปุ่มสำหรับเปิดเว็บไซต์ภายนอก
    </p>

    <div class="buttons">

      <!-- เปลี่ยน URL ตรง href ได้ -->
      <a
        class="btn"
        href="https://example.com"
        target="_blank"
        rel="noopener noreferrer">
        🔗 เปิดเว็บไซต์
      </a>

      <a
        class="btn secondary"
        href="#about">
        ℹ️ เกี่ยวกับ
      </a>

    </div>

  </div>
</section>

</body>
</html>
